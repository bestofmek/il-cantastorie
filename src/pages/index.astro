
---
import '../styles/home.css';

const projects = [
  {
    number: '01',
    category: 'GDR · MONDI FANTASY',
    name: 'Aeldria',
    description:
      'Un mondo da esplorare, storie da vivere e avventure ancora tutte da scrivere.',
    status: 'PRIMO PROGETTO',
    href: '#contatti',
  },
  {
    number: '02',
    category: 'NUOVE CREAZIONI',
    name: 'Prossimamente',
    description:
      'Nuovi universi, nuove idee e nuove storie stanno prendendo forma.',
    status: 'IN ARRIVO',
    href: '#contatti',
  },
];
---

<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Il Cantastorie: un collettivo creativo dedicato ai giochi di ruolo, ai mondi fantasy e alle storie da vivere."
    />
    <meta name="theme-color" content="#090f1b" />
    <title>Il Cantastorie — Ogni mondo ha una storia</title>
  </head>

  <body>
    <!-- HEADER -->
    <header class="site-header">
      <a class="brand" href="#home" aria-label="Torna alla Home">
        <img
          src="/il-cantastorie/images/cantastorie-logo.png"
          alt="Il Cantastorie"
          class="brand-logo"
        />
      </a>

      <nav class="navigation" aria-label="Navigazione principale">
        <a href="#home" aria-label="Home">Home</a>
        <a href="#mondi">I nostri mondi</a>
        <a href="#creazioni">Creazioni</a>
        <a href="#chi-siamo">Chi siamo</a>
        <a class="nav-contact" href="#contatti">Contattaci</a>
      </nav>
    </header>

    <main>
      <!-- HERO / HOME -->
      <section class="hero" id="home">
        <div class="hero-stars"></div>

        <div class="hero-content">
          <span class="eyebrow">UN COLLETTIVO DI CREATIVI</span>

          <h1>
            OGNI MONDO<br />
            HA UNA <span>STORIA.</span>
          </h1>

          <p>
            Noi la immaginiamo, la costruiamo e le diamo vita.
            Benvenuti nel mondo de Il Cantastorie.
          </p>

          <a class="primary-button" href="#mondi">
            ESPLORA I NOSTRI MONDI <span>→</span>
          </a>
        </div>
      </section>

      <!-- INTRODUZIONE -->
      <section class="intro section-padding" id="mondi">
        <div class="section-label">01 / IL NOSTRO UNIVERSO</div>

        <div class="intro-content">
          <h2>
            NON RACCONTIAMO<br />
            SOLO STORIE.<br />
            <span>CREIAMO MONDI.</span>
          </h2>

          <p>
            Siamo un collettivo di creativi uniti dalla passione per
            il fantasy, i giochi di ruolo e la narrazione.
            Diamo forma a universi da esplorare, personaggi da
            incontrare e avventure da ricordare.
          </p>
        </div>
      </section>

      <!-- PROGETTI -->
      <section class="projects section-padding" id="creazioni">
        <div class="section-heading">
          <div>
            <div class="section-label">02 / LE NOSTRE CREAZIONI</div>
            <h2>MONDI DA <span>ESPLORARE.</span></h2>
          </div>

          <p>
            Ogni progetto è un nuovo viaggio.<br />
            E questo è soltanto l'inizio.
          </p>
        </div>

        <div class="project-grid">
          {projects.map((project) => (
            <a
              class={`project-card ${project.number === '01' ? 'featured' : ''}`}
              href={project.href}
            >
              <div class="project-art">
                <span class="project-number">{project.number}</span>
                <span class="project-mark">✧</span>
                <span class="project-status">{project.status}</span>
              </div>

              <div class="project-info">
                <span class="project-category">{project.category}</span>
                <h3>{project.name}</h3>
                <p>{project.description}</p>
                <span class="project-link">SCOPRI IL PROGETTO ↗</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- CHI SIAMO -->
      <section class="manifesto section-padding" id="chi-siamo">
        <div class="section-label">03 / CHI SIAMO</div>

        <div class="manifesto-content">
          <span class="manifesto-symbol">✧</span>

          <h2>
            LE GRANDI STORIE<br />
            NASCONO <span>INSIEME.</span>
          </h2>

          <p>
            Dietro ogni mondo ci sono persone, idee e tanta
            immaginazione. Siamo Il Cantastorie: un gruppo di
            appassionati che trasforma le proprie idee in esperienze
            da condividere.
          </p>

          <a href="#contatti" class="text-link">
            CONOSCI IL NOSTRO MONDO ↗
          </a>
        </div>
      </section>
    </main>

    <!-- FOOTER -->
    <footer class="site-footer" id="contatti">
      <div>
        <a class="footer-brand" href="#home">IL CANTASTORIE</a>
        <p>Ogni mondo ha una storia. Noi la rendiamo realtà.</p>
      </div>

      <div class="footer-right">
        <span>SEGUICI E SCOPRI LE NOSTRE CREAZIONI</span>
        <p>I collegamenti social arriveranno qui.</p>
        <small>© 2026 IL CANTASTORIE · TUTTI I DIRITTI RISERVATI</small>
      </div>
    </footer>
  </body>
</html>